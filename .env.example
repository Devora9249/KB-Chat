# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
DATABASE_URL=postgresql+psycopg://kc:kc@localhost:5432/kc
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Search & Ranking (Racheli)
# Weight applied to release-notes results after RRF fusion, before cutting to k.
# 1.0 = no change (default). Lower values push release notes down. Valid range: (0, 1].
RETRIEVAL_RELEASE_NOTES_WEIGHT=1.0
# Candidates requested from EACH search (vector and text) before RRF fusion.
# The real request is max(this, k). Default 50. Valid range: integer >= 1.
RETRIEVAL_CANDIDATE_K=50
# Time budget for one search call, in seconds. When it expires the search fails
# with RetrievalError. Default 10.0. Valid range: finite number > 0.
RETRIEVAL_TIMEOUT_S=10.0
# Top fused results sent to the reranker (real number is max(this, k)).
# Used only when a reranker is configured. Default 20. Valid range: integer >= 1.
RETRIEVAL_RERANK_CANDIDATES=20
# The reranker's own time budget, in seconds, separate from RETRIEVAL_TIMEOUT_S.
# On expiry (or RerankError) search falls back to the RRF ranking.
# Default 3.0. Valid range: finite number > 0.
RETRIEVAL_RERANK_TIMEOUT_S=3.0
# Which reranker create_reranker builds. Valid values: none | fake | voyage. Default none.
# "none" (default): no reranking and NO external calls; search keeps the RRF ranking.
# "fake": FakeReranker (token overlap), for development and tests only; local, logs a warning.
# "voyage": PRIVACY: sends user queries AND Knowledge Base passage texts to the external
# provider (Voyage AI) and requires VOYAGE_API_KEY above (without it create_reranker raises ValueError).
RETRIEVAL_RERANKER=none
# Voyage rerank model name. Used only when RETRIEVAL_RERANKER=voyage.
# Default rerank-3-lite. Valid: any non-empty string (surrounding spaces are stripped).
RETRIEVAL_RERANK_MODEL=rerank-3-lite

# UI (Chani)
# "api" = Leah's /v1/ask, "fake" = offline canned answers
KC_UI_BACKEND=api
KC_API_BASE_URL=http://127.0.0.1:8000

# API (Leah)
# "fake" = canned FakeAnswerer (every status triggerable, for UI work)
# "rag"  = RagAnswerer: retriever + model, real grounding and citation checks
API_ANSWERER=fake
# Overall deadline for one /v1/ask call, in seconds. Keep it below the UI's 60s timeout.
API_REQUEST_TIMEOUT_S=45
# Passages retrieved per question when API_ANSWERER=rag
API_RAG_K=5
# Model used when API_ANSWERER=rag: "fake" (no key, no cost) or "claude" (real calls,
# needs ANTHROPIC_API_KEY above)
API_LLM=fake
API_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
API_LLM_EFFORT=medium
