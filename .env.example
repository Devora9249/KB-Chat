# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
DATABASE_URL=postgresql+psycopg://kc:kc@localhost:5432/kc
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Search & Ranking (Racheli)
# Weight applied to release-notes results after RRF fusion, before cutting to k.
# 1.0 = no change (default). Lower values push release notes down. Valid range: (0, 1].
RETRIEVAL_RELEASE_NOTES_WEIGHT=1.0

# UI (Chani)
# "api" = Leah's /v1/ask, "fake" = offline canned answers
KC_UI_BACKEND=api
KC_API_BASE_URL=http://127.0.0.1:8000

# API (Leah)
# "fake" = canned FakeAnswerer (every status triggerable, for UI work)
# "rag"  = RagAnswerer: retriever + model, real grounding and citation checks
API_ANSWERER=fake
# Overall deadline for one /v1/ask call, in seconds. Keep it below the UI's 60s timeout.
API_REQUEST_TIMEOUT_S=45
# Passages retrieved per question when API_ANSWERER=rag
API_RAG_K=5
